# PostgreSQL / pgvector
POSTGRES_USER=cv_tailor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cv_tailor
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cv_tailor:change-me@db:5432/cv_tailor

# HTTP ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_API_URL=/api

# Browser origins allowed to call the API (comma separated) and the URL users are
# redirected back to after GitHub OAuth.
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# Auth. JWT_SECRET must be replaced with a random value: the placeholder below
# is public, and anyone who knows it can mint a token for any account.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM provider.
# Each user stores their own API key from the account screen, and every
# generation is billed to that user's provider account. The values below are
# only defaults for new credentials plus an optional single-user fallback.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Leave ALLOW_SHARED_LLM_KEY at 0 for any install with more than one account:
# turning it on lets every user spend the server's LLM_API_KEY.
ALLOW_SHARED_LLM_KEY=0
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embedding. The model must produce 1024-dimension vectors to match the
# pgvector column; shorter vectors are padded and lose retrieval quality.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
FASTEMBED_CACHE_PATH=/var/cache/fastembed

# Upload limits
PDF_IMPORT_MAX_BYTES=5242880

# Encrypts every stored user secret (GitHub tokens and LLM API keys).
# CREDENTIAL_ENCRYPTION_KEY falls back to GITHUB_TOKEN_ENCRYPTION_KEY when unset.
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key-from-python-cryptography

# CV generation pipeline concurrency
PIPELINE_MAX_CONCURRENT=4

# GitHub OAuth and encrypted token storage
GITHUB_OAUTH_CLIENT_ID=replace-with-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key-from-python-cryptography
GITHUB_API_TIMEOUT_SECONDS=20

# CV generation pipeline. Runs are stored in the pipeline_runs table; one that
# stops reporting for this long is treated as abandoned.
PIPELINE_STALE_AFTER_SECONDS=900

# Which pool items end up on the CV.
#  SELECTOR_CANDIDATE_LIMIT: how many items the vector search hands to the ranker.
#    Raise it if your pool is large, or distant projects never get considered.
#  SELECTOR_SELECTION_LIMIT: the most items a CV may carry.
#  SELECTOR_MIN_RELEVANCE: how relevant an item must be to be included at all.
#    Lower it to include more borderline work, raise it to keep the CV tighter.
SELECTOR_CANDIDATE_LIMIT=12
SELECTOR_SELECTION_LIMIT=5
SELECTOR_MIN_RELEVANCE=0.45

# Typst render worker
TYPST_BINARY=typst
TYPST_RENDER_TIMEOUT_SECONDS=5
RENDER_OUTPUT_DIR=/app/storage/generated_cvs
RUN_MIGRATIONS=1

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
