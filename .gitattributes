# Normalise text files in the repository, and let each platform check them out
# the way it prefers.
* text=auto

# These are read by Linux inside containers. A CRLF checkout on Windows breaks
# the shebang ("exec /app/docker-entrypoint.sh: no such file or directory"), so
# they must stay LF regardless of core.autocrlf.
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.typ text eol=lf
*.sql text eol=lf

# Windows-only scripts stay CRLF.
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.svg text
*.pdf binary
